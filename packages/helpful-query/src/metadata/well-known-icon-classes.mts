/**
 * Represents well known icon font classes for reuse.
 */
export enum ZWellKnownIconClasses {
  /**
   * Font Awesome Classic.
   *
   * @see {@link https://fontawesome.com}
   */
  FontAwesome = "https://fontawesome.com",

  /**
   * Font Awesome Brands.
   *
   * @see {@link https://fontawesome.com/search?o=r&f=brands}
   */
  FontAwesomeBrands = "https://fontawesome.com/search?o=r&f=brands",

  /**
   * Font Awesome Sharp.
   *
   * @see {@link https://fontawesome.com/search?o=r&f=sharp}
   */
  FontAwesomeSharp = "https://fontawesome.com/search?o=r&f=sharp",

  /**
   * Material design.
   *
   * @see {@link https://mui.com/material-ui/material-icons}
   */
  Material = "https://mui.com/material-ui/material-icons",
}
