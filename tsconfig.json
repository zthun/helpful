{
  "extends": [
    "@zthun/janitor-ts-config/base",
    "@zthun/janitor-ts-config/browser",
    "@zthun/janitor-ts-config/react"
  ],
  "compilerOptions": {
    "baseUrl": "packages",
    "paths": {
      "@zthun/helpful-brands": ["helpful-brands/src/index.mts"],
      "@zthun/helpful-fn": ["helpful-fn/src/index.mts"],
      "@zthun/helpful-internet": ["helpful-internet/src/index.mts"],
      "@zthun/helpful-node": ["helpful-node/src/index.mts"],
      "@zthun/helpful-query": ["helpful-query/src/index.mts"],
      "@zthun/helpful-react": ["helpful-react/src/index.mts"],
      "@zthun/helpful-reflection": ["helpful-reflection/src/index.mts"],
      "@zthun/helpful-validation": ["helpful-validation/src/index.mts"]
    }
  },
  "include": ["**/*.ts", "**/*.mts"]
}
