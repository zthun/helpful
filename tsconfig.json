{
  "extends": [
    "@zthun/janitor-ts-config/base",
    "@zthun/janitor-ts-config/browser",
    "@zthun/janitor-ts-config/react"
  ],
  "compilerOptions": {
    "paths": {
      "@zthun/helpful-brands": ["./packages/helpful-brands/src/index.mts"],
      "@zthun/helpful-fn": ["./packages/helpful-fn/src/index.mts"],
      "@zthun/helpful-internet": ["./packages/helpful-internet/src/index.mts"],
      "@zthun/helpful-node": ["./packages/helpful-node/src/index.mts"],
      "@zthun/helpful-query": ["./packages/helpful-query/src/index.mts"],
      "@zthun/helpful-react": ["./packages/helpful-react/src/index.mts"],
      "@zthun/helpful-reflection": [
        "./packages/helpful-reflection/src/index.mts"
      ],
      "@zthun/helpful-validation": [
        "./packages/helpful-validation/src/index.mts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.mts"]
}
