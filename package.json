{
  "name": "@zthun/helpful",
  "description": "Useful low level classes and functions that help with common tasks.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/helpful"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates'",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@zthun/janitor-build-config": "^19.5.6",
    "@zthun/janitor-lint": "^19.5.6",
    "@zthun/janitor-lint-config": "^19.5.6",
    "@zthun/janitor-options": "^19.5.6",
    "@zthun/janitor-ts-config": "^19.5.3",
    "happy-dom": "^20.5.1",
    "husky": "^9.1.7",
    "lerna": "^9.0.3",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.13.0"
}
